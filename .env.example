# ---------------------------------------------------------------------------
# MO (MyOffice) — contoh konfigurasi. Salin menjadi .env lalu sesuaikan.
# Jangan pernah melakukan commit berkas .env yang berisi kredensial sungguhan.
# ---------------------------------------------------------------------------

APP_NAME="MO (MyOffice)"
APP_ENV=production          # production | development
APP_DEBUG=false             # jangan true di produksi
APP_URL=https://contoh.com
APP_KEY=                    # 32 byte acak base64; dipakai enkripsi data sensitif
APP_TIMEZONE=UTC            # seluruh data waktu disimpan UTC

# ---------------------------------------------------------------------------
# Database. Produksi: mysql. Sandbox/pengujian: sqlite.
# ---------------------------------------------------------------------------
DB_DRIVER=mysql             # mysql | sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mo_hris
DB_USERNAME=mo_user
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PATH=storage/database/mo.sqlite   # hanya untuk sqlite

# ---------------------------------------------------------------------------
# Sesi
# ---------------------------------------------------------------------------
SESSION_NAME=MOSESSID
SESSION_LIFETIME=28800      # detik (8 jam)
SESSION_IDLE=7200           # detik (2 jam)
SESSION_SECURE=true         # true bila memakai HTTPS

# ---------------------------------------------------------------------------
# Surat (opsional). Kosongkan bila belum dikonfigurasi.
# ---------------------------------------------------------------------------
MAIL_DRIVER=log             # log | smtp
MAIL_FROM_NAME="MO (MyOffice)"
MAIL_FROM_ADDRESS=no-reply@contoh.com
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=
MAIL_SMTP_PASSWORD=
MAIL_SMTP_ENCRYPTION=tls

# ---------------------------------------------------------------------------
# Unggahan
# ---------------------------------------------------------------------------
UPLOAD_MAX_SIZE=5242880     # 5 MB dalam byte
UPLOAD_ALLOWED_TYPES=jpg,jpeg,png,pdf,doc,docx,xls,xlsx,csv

# ---------------------------------------------------------------------------
# Batasan & kebijakan
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOG_RETENTION_DAYS=365
LOCALE_DEFAULT=id
LOCALE_FALLBACK=en
